{
  "name": "zionfood-wordpress",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node bin/build-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write \"assets/src/**/*.{js,css}\" \"tests/**/*.mjs\" \"tests/**/*.js\" \"bin/*.mjs\" playwright.config.js",
    "format:check": "prettier --check \"assets/src/**/*.{js,css}\" \"tests/**/*.mjs\" \"tests/**/*.js\" \"bin/*.mjs\" playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "leaflet": "1.9.4",
    "prettier": "3.9.10"
  }
}
